{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/grace-context\" codex SessionStart",
            "commandWindows": "& \"$env:PLUGIN_ROOT/bin/grace-context.exe\" codex SessionStart; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/grace-context\" codex UserPromptSubmit",
            "commandWindows": "& \"$env:PLUGIN_ROOT/bin/grace-context.exe\" codex UserPromptSubmit; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__grace__grace_resolve_context$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/grace-context\" codex PreToolUse",
            "commandWindows": "& \"$env:PLUGIN_ROOT/bin/grace-context.exe\" codex PreToolUse; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
