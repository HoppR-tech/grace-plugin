{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/grace-context\" copilot SessionStart",
            "powershell": "& \"$env:PLUGIN_ROOT/bin/grace-context.exe\" copilot SessionStart; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/grace-context\" copilot UserPromptSubmit",
            "powershell": "& \"$env:PLUGIN_ROOT/bin/grace-context.exe\" copilot UserPromptSubmit; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^grace-grace_resolve_context$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/grace-context\" copilot PreToolUse",
            "powershell": "& \"$env:PLUGIN_ROOT/bin/grace-context.exe\" copilot PreToolUse; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
